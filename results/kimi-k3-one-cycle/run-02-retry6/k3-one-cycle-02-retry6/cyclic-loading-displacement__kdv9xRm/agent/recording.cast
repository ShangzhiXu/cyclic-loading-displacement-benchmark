[929.989219, "o", "t=0.76 q=  46.0 d=1.5596288 mod=1.5217237 deq=1.5056957 res=-3.79e-02\r\nt=0.80 q=  30.0 d=1.3738000 mod=1.3536375 deq=1.3364279 res=-2.02e-02\r\nt=0.84 q=  30.0 d=1.3467870 mod=1.3364302 deq=1.3364279 res=-1.04e-02\r\nt=0.88 q=  30.0 d=1.3382074 mod=1.3364279 deq=1.3364279 res=-1.78e-03\r\n"]
[929.989251, "o", "t=0.92 q=  30.0 d=1.3365369 mod=1.3364279 deq=1.3364279 res=-1.09e-04\r\nt=0.96 q=  30.0 d=1.3366341 mod=1.3364279 deq=1.3364279 res=-2.06e-04\r\nt=1.00 q=  30.0 d=1.3363806 mod=1.3364279 deq=1.3364279 res=+4.73e-05\r\nt=1.04 q=  30.0 d=1.3364640 mod=1.3364279 deq=1.3364279 res=-3.60e-05\r\nt=1.08 q=  30.0 d=1.3364374 mod=1.3364279 deq=1.3364279 res=-9.51e-06\r\nt=1.12 q=  30.0 d=1.3364214 mod=1.3364279 deq=1.3364279 res=+6.48e-06\r\nt=1.16 q=  30.0 d=1.3364272 mod=1.3364279 deq=1.3364279 res=+7.34e-07\r\n"]
