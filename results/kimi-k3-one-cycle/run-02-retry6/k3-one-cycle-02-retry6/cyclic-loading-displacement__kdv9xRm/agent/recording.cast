[2417.523195, "o", "\u001b[?2004h"]
[2417.523221, "o", "> "]
[2417.523501, "o", "print('unload  knots u:', np.round(np.concatenate([[DEND],sol.x[5:10],[DPEAK]]),6))\r\n\u001b[?2004l\r"]
[2417.523523, "o", "\u001b[?2004h"]
[2417.523543, "o", "> "]
[2417.52367, "o", "print('w,zeta:', sol.x[10], sol.x[11])\r\n\u001b[?2004l\r"]
[2417.523693, "o", "\u001b[?2004h"]
[2417.523711, "o", "> "]
[2417.523776, "o", "m = simulate(sol.x)\r\n\u001b[?2004l\r"]
