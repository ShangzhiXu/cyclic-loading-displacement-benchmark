[2417.520219, "o", "    deqq = np.where(load, deq_load, deq_unl)\r\n\u001b[?2004l\r"]
[2417.520278, "o", "\u001b[?2004h> "]
[2417.520418, "o", "    dd = np.zeros_like(tq); vv = np.zeros_like(tq)\r\n\u001b[?2004l\r"]
[2417.520449, "o", "\u001b[?2004h"]
[2417.520477, "o", "> "]
[2417.520504, "o", "    w2 = w*w"]
[2417.520526, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[2417.520546, "o", "> "]
[2417.520638, "o", "    for k in range(1,len(tq)):\r\n\u001b[?2004l\r"]
[2417.520661, "o", "\u001b[?2004h"]
[2417.52068, "o", "> "]
[2417.520862, "o", "        acc = w2*(deqq[k-1]-dd[k-1]) - 2.0*z*w*vv[k-1]\r\n\u001b[?2004l\r"]
[2417.520885, "o", "\u001b[?2004h"]
[2417.520903, "o", "> "]
[2417.521012, "o", "        vv[k] = vv[k-1] + dt*acc\r\n\u001b[?2004l\r"]
[2417.521037, "o", "\u001b[?2004h"]
[2417.521058, "o", "> "]
[2417.521171, "o", "        dd[k] = dd[k-1] + dt*vv[k]\r\n\u001b[?2004l\r"]
[2417.521197, "o", "\u001b[?2004h"]
[2417.521218, "o", "> "]
[2417.521321, "o", "    return np.interp(t, tq, dd)\r\n\u001b[?2004l\r"]
[2417.521343, "o", "\u001b[?2004h"]
[2417.521371, "o", "> \r\n\u001b[?2004l\r"]
[2417.521394, "o", "\u001b[?2004h> "]
[2417.521465, "o", "def resid(params):\r\n\u001b[?2004l\r"]
[2417.521491, "o", "\u001b[?2004h"]
[2417.521512, "o", "> "]
[2417.521607, "o", "    return simulate(params)-d\r\n\u001b[?2004l\r"]
[2417.521631, "o", "\u001b[?2004h"]
[2417.521654, "o", "> \r\n"]
[2417.521674, "o", "\u001b[?2004l\r\u001b[?2004h"]
[2417.521693, "o", "> "]
[2417.521896, "o", "x0 = [0.8,1.3,1.6,1.85,2.05,  1.6,1.8,1.95,2.08,2.16, 40.0,1.0]\r\n\u001b[?2004l\r"]
[2417.52192, "o", "\u001b[?2004h"]
[2417.521939, "o", "> "]
[2417.522016, "o", "lb = [0.0]*10+[5.0,0.2]\r\n\u001b[?2004l\r"]
[2417.522038, "o", "\u001b[?2004h"]
[2417.522058, "o", "> "]
[2417.522142, "o", "ub = [3.0]*10+[300.0,8.0]\r\n\u001b[?2004l\r"]
[2417.522165, "o", "\u001b[?2004h"]
[2417.522183, "o", "> "]
[2417.522602, "o", "sol = least_squares(resid, x0, bounds=(lb,ub), method='trf', xtol=1e-14, gtol=1e-14, ftol=1e-14, max_nfev=4000, verbose=0)\r\n\u001b[?2004l\r"]
[2417.522631, "o", "\u001b[?2004h> "]
[2417.522757, "o", "rms = np.sqrt(np.mean(sol.fun**2))\r\n\u001b[?2004l\r"]
