[?2004hroot@f7b6f33f28de:/app/work# cat > fit1.py << 'EOF'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> from scipy.optimize import least_squares
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/app/data/first_cycle.csv')
[?2004l[?2004h> t = df['phase_s'].values; q = df['pressure_kpa'].values; d = df['displacement_mm'].values
[?2004l[?2004h> DPEAK = 2.223978563168; DEND = 1.336427932088
[?2004l[?2004h> 
[?2004l[?2004h> def simulate(params, ret_eq=False):
[?2004l[?2004h>     a1,b1,b2,tau = params
[?2004l[?2004h>     a2 = (DPEAK-DEND)/(120.0**b2)
[?2004l[?2004h>     # build equilibrium target per sample
[?2004l[?2004h>     deq = np.zeros_like(q)
[?2004l[?2004h>     for i,qi in enumerate(q):
[?2004l[?2004h>         if t[i] <= 0.5+1e-12:  # loading branch (ramp up + high hold)
[?2004l[?2004h>             deq[i] = a1*max(qi-30.0,0.0)**b1
[?2004l[?2004h>         else:                  # unloading branch
[?2004l[?2004h>             deq[i] = DPEAK - a2*(150.0-qi)**b2
[?2004l[?2004h>     # enforce anchor at peak
[?2004l[?2004h>     # integrate with fine dt
[?2004l[?2004h>     dt = 0.001
[?2004l[?2004h>     tq = np.arange(0,1.3+1e-12,dt)
[?2004l[?2004h>     qq = np.interp(tq, t, q)
[?2004l[?2004h>     deqq = np.interp(tq, t, deq)
[?2004l[?2004h>     dd = np.zeros_like(tq)
[?2004l[?2004h>     dd[0]=0.0
[?2004l[?2004h>     for k in range(1,len(tq)):
[?2004l[?2004h>         dd[k] = dd[k-1] + dt*(deqq[k]-dd[k-1])/tau
[?2004l[?2004h>     dmod = np.interp(t, tq, dd)
[?2004l[?2004h>     if ret_eq: return dmod, deq
[?2004l[?2004h>     return dmod
[?2004l[?2004h> 
[?2004l[?2004h> def resid(params):
[?2004l[?2004h>     return simulate(params)-d
[?2004l[?2004h> 
[?2004l[?2004h> x0 = [0.3,0.5,0.5,0.03]
[?2004l[?2004h> sol = least_squares(resid, x0, bounds=([1e-4,0.1,0.1,0.005],[10.0,2.0,2.0,0.2]), method='trf', xtol=1e-15, gtol=1e-15, ftol=1e-15, max_nfev=20000)
[?2004l[?2004h> print('params a1,b1,b2,tau =', sol.x)
[?2004l[?2004h> print('rms resid =', np.sqrt(np.mean(sol.fun**2)))
[?2004l[?2004h> dmod, deq = simulate(sol.x, ret_eq=True)
[?2004l[?2004h> for i in range(0,len(t),2):
[?2004l[?2004h>     print(f't={t[i]:.2f} q={q[i]:6.1f} d={d[i]:.7f} mod={dmod[i]:.7f} deq={deq[i]:.7f} res={dmod[i]-d[i]:+.2e}')
[?2004l[?2004h> EOF
