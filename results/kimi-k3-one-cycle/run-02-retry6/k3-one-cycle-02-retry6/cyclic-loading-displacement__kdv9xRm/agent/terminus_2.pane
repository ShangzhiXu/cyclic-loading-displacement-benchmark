[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> df = pd.read_csv('/app/data/first_cycle.csv')
[?2004l[?2004h> t = df['phase_s'].values
[?2004l[?2004h> q = df['pressure_kpa'].values
[?2004l[?2004h> d = df['displacement_mm'].values
[?2004l[?2004h> 
[?2004l[?2004h> # Relaxation during high hold (t=0.3..0.5)
[?2004l[?2004h> mask = (t>=0.30)&(t<=0.50)
[?2004l[?2004h> th, dh = t[mask], d[mask]
[?2004l[?2004h> dinf = dh[-1]
[?2004l[?2004h> print('high hold: d_inf =', dinf)
[?2004l[?2004h> for i in range(len(th)-1):
[?2004l[?2004h>     R = dinf - dh[i]
[?2004l[?2004h>     if R>1e-6:
[?2004l[?2004h>         print(f'  t={th[i]:.2f} d={dh[i]:.7f} R={R:.6f}')
[?2004l[?2004h> # tau from successive ratios
[?2004l[?2004h> Rs = dinf - dh[:-1]
[?2004l[?2004h> Rs = Rs[Rs>1e-7]
[?2004l[?2004h> ratios = Rs[1:]/Rs[:-1]
[?2004l[?2004h> print('  ratios per 0.02s:', np.round(ratios,4))
[?2004l[?2004h> print('  tau estimates:', np.round(-0.02/np.log(ratios),5))
[?2004l[?2004h> 
[?2004l[?2004h> # Relaxation during low hold (t=0.8..1.3)
[?2004l[?2004h> mask = (t>=0.80)
[?2004l[?2004h> tl, dl = t[mask], d[mask]
[?2004l[?2004h> dinfl = 1.3364279  # converged value
[?2004l[?2004h> print('low hold:')
[?2004l[?2004h> Rl = dl - dinfl
[?2004l[?2004h> for i in range(8):
[?2004l[?2004h>     print(f'  t={tl[i]:.2f} d={dl[i]:.7f} R={Rl[i]:.6f}')
[?2004l[?2004h> rr = Rl[1:8]/Rl[0:7]
[?2004l[?2004h> print('  ratios:', np.round(rr,4), ' tau:', np.round(-0.02/np.log(rr),5))
[?2004l[?2004h> EOF
