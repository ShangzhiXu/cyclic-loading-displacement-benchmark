[?2004l[?2004h> print('E=%.4f K=%.4f tau=%.5f eta=%.4f H=%.4f n=%.4f qy=%.5f' % (E,K,tau,eta,H,n,qy))
[?2004l[?2004h> ufit = simulate(sol.x)
[?2004l[?2004h> for i in range(0, len(td), 5):
