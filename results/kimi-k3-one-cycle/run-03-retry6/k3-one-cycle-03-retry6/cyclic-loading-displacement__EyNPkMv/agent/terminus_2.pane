[?2004l[?2004h> td = df['phase_s'].values; ud = df['displacement_mm'].values
[?2004l[?2004h> 
[?2004l[?2004h> def qfun(t):
[?2004l[?2004h>     # pressure above 30 kPa preload, kPa
[?2004l[?2004h>     if t < 0.3: return 400.0*t
[?2004l[?2004h>     if t < 0.5: return 120.0
[?2004l[?2004h>     if t < 0.8: return 120.0 - 400.0*(t-0.5)
[?2004l[?2004h>     return 0.0
[?2004l[?2004h> 
[?2004l[?2004h> def simulate(params, ncyc=1, dt=1e-4, record=True):
[?2004l[?2004h>     logE, logK, logtau, logeta, logH, n, logqy = params
[?2004l[?2004h>     E, K, tau, eta, H, qy = np.exp(logE), np.exp(logK), np.exp(logtau), np.exp(logeta), np.exp(logH), np.exp(logqy)
[?2004l[?2004h>     T = 1.3*ncyc
[?2004l[?2004h>     steps = int(round(T/dt))
[?2004l[?2004h>     out_t, out_u = [], []
[?2004l[?2004h>     uk = 0.0; up = 0.0
[?2004l[?2004h>     # sample recording times for cycle 1
[?2004l[?2004h>     rec_times = td
[?2004l[?2004h>     ri = 0
[?2004l[?2004h>     for i in range(steps+1):
[?2004l[?2004h>         t = i*dt
[?2004l[?2004h>         # record cycle-1 samples
[?2004l[?2004h>         while ri < len(rec_times) and rec_times[ri] <= t + 1e-12:
[?2004l[?2004h>             q = qfun(rec_times[ri])
[?2004l[?2004h>             out_u.append(q/E + uk + up); ri += 1
[?2004l[?2004h>         if i == steps: break
[?2004l[?2004h>         q = qfun(t)
[?2004l[?2004h>         def rhs(uk, up, t):
[?2004l[?2004h>             q = qfun(t)
[?2004l[?2004h>             duk = (q/K - uk)/tau
[?2004l[?2004h>             drive = q - qy - H*up
[?2004l[?2004h>             dup = (drive/eta)**n if drive > 0 else 0.0
[?2004l[?2004h>             return duk, dup
[?2004l[?2004h>         k1 = rhs(uk, up, t)
[?2004l[?2004h>         k2 = rhs(uk+0.5*dt*k1[0], up+0.5*dt*k1[1], t+0.5*dt)
[?2004l[?2004h>         k3 = rhs(uk+0.5*dt*k2[0], up+0.5*dt*k2[1], t+0.5*dt)
[?2004l[?2004h>         k4 = rhs(uk+dt*k3[0], up+dt*k3[1], t+dt)
[?2004l[?2004h>         uk += dt/6*(k1[0]+2*k2[0]+2*k3[0]+k4[0])
[?2004l[?2004h>         up += dt/6*(k1[1]+2*k2[1]+2*k3[1]+k4[1])
[?2004l[?2004h>     return np.array(out_u)
[?2004l[?2004h> 
[?2004l[?2004h> def resid(params):
[?2004l[?2004h>     u = simulate(params)
[?2004l[?2004h>     return u - ud
[?2004l[?2004h> 
[?2004l[?2004h> # initial guesses
