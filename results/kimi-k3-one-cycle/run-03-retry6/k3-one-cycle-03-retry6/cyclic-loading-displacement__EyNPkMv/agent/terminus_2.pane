[?2004hroot@01279233795f:/app# mkdir -p /app/work && cd /app/work
[?2004l[?2004hroot@01279233795f:/app/work# cat > analyze1.py << 'EOF'
[?2004l[?2004h> import numpy as np, pandas as pd
[?2004l[?2004h> df = pd.read_csv('/app/data/first_cycle.csv')
[?2004l[?2004h> t = df['phase_s'].values; p = df['pressure_kpa'].values; u = df['displacement_mm'].values
[?2004l[?2004h> # segments
[?2004l[?2004h> up = (t>=0)&(t<=0.3); hh=(t>=0.3)&(t<=0.5); dn=(t>=0.5)&(t<=0.8); lh=(t>=0.8)
[?2004l[?2004h> print('RAMP UP: log-log fit u vs (p-30)')
[?2004l[?2004h> mask = up & (t>0)
[?2004l[?2004h> x = np.log(p[mask]-30); y=np.log(u[mask])
[?2004l[?2004h> A = np.vstack([x, np.ones_like(x)]).T
[?2004l[?2004h> m, lna = np.linalg.lstsq(A, y, rcond=None)[0]
[?2004l[?2004h> print('power m=%.4f a=%.6f'%(m, np.exp(lna)))
[?2004l[?2004h> resid = u[mask] - np.exp(lna)*(p[mask]-30)**m
[?2004l[?2004h> print('max resid', np.abs(resid).max())
[?2004l[?2004h> print()
[?2004l[?2004h> print('first points u/(p-30)**(1/3):', (u[mask]/(p[mask]-30)**(1/3))[:5])
[?2004l[?2004h> print('last points  u/(p-30)**(1/3):', (u[mask]/(p[mask]-30)**(1/3))[-5:])
[?2004l[?2004h> print()
[?2004l[?2004h> print('HIGH HOLD creep (u - u_end_of_hold):')
[?2004l[?2004h> uh = u[hh]; th=t[hh]
[?2004l[?2004h> creep = uh[-1]-uh
[?2004l[?2004h> print(np.column_stack([th, uh, creep]))
[?2004l[?2004h> print('increments:', np.diff(uh))
[?2004l[?2004h> print('ratio of increments:', np.diff(uh)[:-1]/np.diff(uh)[1:])
[?2004l[?2004h> print()
[?2004l[?2004h> print('LOW HOLD relaxation:')
[?2004l[?2004h> ul=u[lh]; tl=t[lh]
[?2004l[?2004h> print('increments:', np.diff(ul)[:8])
[?2004l[?2004h> print('final value', ul[-1])
[?2004l[?2004h> EOF
